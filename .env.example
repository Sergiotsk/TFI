# URL pública de la app. Se usa en build y en runtime.
NEXT_PUBLIC_APP_URL=https://tfi.vadonedev.com.ar

# Proyecto de Supabase (cloud).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo servidor: lo usa el webhook de MercadoPago.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# MercadoPago.
PAGOS_PASARELA=mercadopago
MP_ACCESS_TOKEN=APP_USR-...
# MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET=

# Cloudflare Tunnel: se completa recién cuando creás el tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
