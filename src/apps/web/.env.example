NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_valor_falso

# Clave de servicio: SOLO en el servidor. La usan el webhook de pagos y el
# restablecimiento asistido de contraseñas. Nunca exponerla con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Suite de contratos contra una base real (ver src/packages/infrastructure/supabase/entorno-de-prueba.ts).
# La clave de servicio hace falta solo para los tests que leen public.perfiles directo.
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_PUBLISHABLE_KEY=sb_publishable_valor_falso
SUPABASE_TEST_SERVICE_ROLE_KEY=sb_secret_valor_falso

# MercadoPago (excepción temporal para la demo/MVP, ADR-0012).
# Con PAGOS_PASARELA=off el botón de pago online no se muestra.
MP_ACCESS_TOKEN=
# Secreto del webhook para validar x-signature. Si falta, se valida el pago
# contra GET /v1/payments/:id (menos estricto, solo aceptable en demo).
MP_WEBHOOK_SECRET=

# URL pública de la app, sin barra final. Es obligatoria en producción: se usa
# en las back_urls de MercadoPago, en el webhook y en los redirectTo de los
# emails de Supabase. El dominio también va en las Redirect URLs del proyecto.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAGOS_PASARELA=off  # off | mercadopago
