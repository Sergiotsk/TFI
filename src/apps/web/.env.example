NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_valor_falso

# Destino de los botones "Ir al sistema de inscripción" de la landing (por defecto, /login).
NEXT_PUBLIC_SISTEMA_URL=/login
# SUPABASE_SERVICE_ROLE_KEY=  # SOLO para webhook Pagos360, NO en login

# Suite de contratos contra una base real (ver src/packages/infrastructure/supabase/entorno-de-prueba.ts).
# La clave de servicio hace falta solo para los tests que leen public.perfiles directo.
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_PUBLISHABLE_KEY=sb_publishable_valor_falso
SUPABASE_TEST_SERVICE_ROLE_KEY=sb_secret_valor_falso

# MercadoPago (pasarela)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=
# URL pública de la app. Se usa en las back_urls de MercadoPago y en los
# redirectTo de los emails de Supabase (confirmar cuenta / recuperar contraseña):
# tienen que volver a <NEXT_PUBLIC_APP_URL>/auth/confirmar, así que este dominio
# también va en las Redirect URLs del proyecto de Supabase.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAGOS_PASARELA=off  # off | mercadopago


# Supabase service role (solo servidor/webhook)
SUPABASE_SERVICE_ROLE_KEY=

