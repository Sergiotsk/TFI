{
  "name": "tfi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "lint": "eslint .",
    "test": "vitest run --project unidad",
    "test:watch": "vitest --project unidad",
    "test:contratos": "vitest run --project contratos --passWithNoTests",
    "migraciones:verificar": "node scripts/migraciones/verificar.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
